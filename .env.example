# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Server
PORT=3000

# Auth — JWT secret (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret

# Google auth (coming soon — leave empty for now)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AI — Text (OpenRouter: GPT-4o, Gemini, Claude)
OPENROUTER_API_KEY=sk-or-xxx

# AI — Images (optional; unset = placeholder URLs)
FAL_KEY=xxx
REPLICATE_API_TOKEN=r8_xxx

# Optional: base URL for OpenRouter referer
# API_URL=https://api.contentai.app
